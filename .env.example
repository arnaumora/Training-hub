# Copy to .env on the server and fill in. The real .env never goes into git.

# Postgres
POSTGRES_USER=traininghub
POSTGRES_DB=traininghub
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Signs the login session cookie. Changing it logs every session out.
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me

# The login password is NOT here. Its hash lives in secrets/app_password_hash,
# created with: python -m app.set_password (see the deploy notes).

# Barcode lookups (optional): Open Food Facts asks every app to identify itself with a contact
# e-mail in its User-Agent ("TrainingHub/1.0 (you@example.com)"). Leave empty to send none.
OFF_CONTACT=

# Garmin sync (optional): how many days of activities the very first sync fetches. Default 30.
GARMIN_BACKFILL_DAYS=30

# AI analysis (step 8): the reports run on Gemini by default; the Claude key is optional (Claude is used
# through the desktop app instead). Only the analysis service receives these.
# Gemini: aistudio.google.com > Get API key. Free tier: Google uses the content to improve its products;
# with billing on the project (paid tier) it does not. Claude: console.anthropic.com > API keys (paid).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
